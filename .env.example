# ==============================================================================
# CigarConnect — Variables d'Environnement (Supabase & Prisma)
# ==============================================================================

# URL de l'application
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 1. Base de Données Supabase (PostgreSQL) — Configuration Prisma
# ------------------------------------------------------------------------------
# Dans votre Dashboard Supabase :
# Aller dans : Project Settings > Database > Connection string > URI

# Mode Pooled (Transaction pooler - port 6543) : Utilisé pour les requêtes de l'application
DATABASE_URL="postgresql://postgres.[VOTRE-PROJECT-REF]:[VOTRE-MOT-DE-PASSE]@aws-0-[VOTRE-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Mode Direct (Session - port 5432) : Requis par Prisma pour exécuter les migrations (`prisma db push` / `prisma migrate`)
DIRECT_URL="postgresql://postgres.[VOTRE-PROJECT-REF]:[VOTRE-MOT-DE-PASSE]@aws-0-[VOTRE-REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. API Supabase — Client JS (Authentification, Stockage Photos, Realtime)
# ------------------------------------------------------------------------------
# Dans votre Dashboard Supabase :
# Aller dans : Project Settings > API

# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://[VOTRE-PROJECT-REF].supabase.co"

# Clé publique anonyme (anon key - safe pour le navigateur)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Clé de service secrète (service_role - UNIQUEMENT côté serveur, ne JAMAIS exposer publiquement)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
